{
    "name": "modules/esign",
    "description": "Sequential borrower/lender eSign workflow with combined BL report + sanction PDF support",
    "type": "laravel-module",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Modules\\ESign\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\ESign\\Tests\\": "tests/"
        }
    }
